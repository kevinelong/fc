-- TAG  ·  multiplayer. One player is "it" (red). If "it" touches you, you're it!
-- Now a TIMED MATCH: whoever is "it" when the clock hits zero loses.
-- Open on two devices (or two windows) in the same room. Arrows / D-pad to move.

join game "dots" room "lobby"

mode is "play"
me is {x: 64, y: 64, tag: 0, safe: 0, wasit: no, id: 0, host: no, clock: 0, amit: no}
me.x is 16 + random 96
me.y is 16 + random 96
me.tag is random 1000
me.id is random 100000

-- optional match timer (the lowest-id player owns the authoritative clock)
time limit is 30 seconds

define sound "tag" as square from 200 to 900 over 0.12

when time runs out
  mode is "over"

to update
  -- host election: lowest id owns the clock and shares it; others adopt it
  amhost is yes
  each peer in peers
    if peer.id < me.id
      amhost is no
  me.host is amhost
  if amhost
    me.clock is timer
  else
    each peer in peers
      if peer.host
        me.clock is peer.clock

  if mode is "play"
    if key "right" me.x is me.x + 1.5
    if key "left"  me.x is me.x - 1.5
    if key "up"    me.y is me.y - 1.5
    if key "down"  me.y is me.y + 1.5
    if me.x < 2 me.x is 2
    if me.x > 120 me.x is 120
    if me.y < 2 me.y is 2
    if me.y > 120 me.y is 120

    -- who is "it"? whoever has the highest tag number (me or a peer)
    top is me.tag
    each peer in peers
      if peer.tag > top
        top is peer.tag
    amit is no
    if me.tag >= top
      amit is yes
    me.amit is amit

    -- when your "it" status just flipped, take a short breather (no instant tag-backs)
    if amit is not me.wasit
      me.safe is 40
    me.wasit is amit
    if me.safe > 0
      me.safe is me.safe - 1

    -- if you're a runner and "it" touches you, YOU become "it"
    if amit is no
      if me.safe <= 0
        each peer in peers
          if peer.tag is top
            if peer.x > me.x - 6 and peer.x < me.x + 6
              if peer.y > me.y - 6 and peer.y < me.y + 6
                me.tag is top + 1
                me.safe is 40
                play sound "tag"

  -- share my position, tag, host clock + "it" status a few times a second
  every 4 frames
    broadcast {x: me.x, y: me.y, tag: me.tag, id: me.id, host: me.host, clock: me.clock, amit: me.amit}

to draw
  clear screen to dark blue
  -- highest tag (me or a peer) is "it" -> red; runners -> blue/green
  top is me.tag
  each peer in peers
    if peer.tag > top
      top is peer.tag
  each peer in peers
    if peer.tag is top
      draw rect at peer.x, peer.y size 6, 6 in red
    else
      draw rect at peer.x, peer.y size 6, 6 in blue
  if me.amit
    draw rect at me.x, me.y size 6, 6 in red
  else
    draw rect at me.x, me.y size 6, 6 in green

  if mode is "play"
    if me.amit
      write "YOU'RE IT" at 6, 2 in red on hud
    else
      write "RUN!" at 6, 2 in green on hud
    -- the match clock (flashes red under 6 seconds)
    if me.clock < 6
      write "time {me.clock}" at 78, 2 in red on hud
    else
      write "time {me.clock}" at 78, 2 in yellow on hud
  if mode is "over"
    if me.amit
      write "TIME! you were IT" at 16, 50 in red on hud
      write "you lose" at 44, 62 in white on hud
    else
      write "TIME! you escaped" at 16, 50 in green on hud
      write "you win!" at 44, 62 in white on hud

run game with update and draw
