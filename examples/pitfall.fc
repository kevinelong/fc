-- PITFALL HOP  ·  press SPACE (or tap) to jump the rolling logs.
-- Click the screen first so it hears the keys.

-- world is short, so the floor (world bottom - 8) sits at y = 104
world is {width: 128, height: 112}
mode is "play"
score is 0
gravity is 0.5
player is {x: 24, y: 104, image: "hero", dy: 0}
logs is []

define sound "hop" as square from 300 to 700 over 0.12
define sound "ow" as noise from 1000 to 80 over 0.35
define sound "point" as square from 700 to 1100 over 0.07

when "space" is pressed
  if player.y >= 103
    if mode is "play" jump player
    play sound "hop"
when mouse is clicked
  if player.y >= 103
    if mode is "play" jump player
    play sound "hop"

to update
  if mode is not "play" return

  -- a new log every ~1.2s
  every 70 frames
    log is sprite
    log.x is 128
    log.y is 104
    log.image is "stone"
    log.passed is no
    add log to logs

  each log in logs
    log.x is log.x - 1.6
    -- score once it passes you
    if log.x + 8 < player.x and log.passed is no
      log.passed is yes
      add 1 to score
      play sound "point"
    -- hit it if you're not high enough
    if player.x + 6 > log.x and player.x < log.x + 7
      if player.y + 7 > log.y
        mode is "lose"
        play sound "ow"

  -- drop the oldest log once it scrolls off
  if the number of logs > 0
    oldest is item 1 of logs
    if oldest.x < -10 remove oldest from logs

to draw
  clear screen to dark blue
  draw rect at 0, 112 size 128, 16 in dark green
  each log in logs draw sprite log.image at log.x, log.y
  draw sprite player.image at player.x, player.y
  write "score {score}" at 2, 2 in white on hud

to screen lose
  write "GAME OVER" at 32, 50 in red on hud
  write "score {score}" at 38, 66 in white on hud

run game with update and draw
