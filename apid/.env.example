# Copy to .env (chmod 600). Leave a provider blank to disable its button.
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin used to build the GitHub callback URL:
ORIGIN=https://codeonline.io
PORT=8092

# Email verification (Gmail SMTP relay; app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_FROM=codeonline.io <you@gmail.com>
